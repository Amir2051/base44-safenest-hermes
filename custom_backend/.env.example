# Dedicated custom-backend database only. Do not point this at the SafeNestT production DB.
DATABASE_URL=postgresql://safenestt_auth:replace-with-local-secret@127.0.0.1:55433/safenestt_custom_auth

# Generate independent random values of at least 32 characters. Never commit real values.
AUTH_CSRF_SECRET=replace-with-at-least-32-random-characters
AUTH_COOKIE_SECURE=true
AUTH_ALLOWED_ORIGINS=https://safenestt.com,https://www.safenestt.com
AUTH_DB_POOL_MAX=10

# Existing private Hermes adapter configuration remains separate.
CUSTOM_BACKEND_SERVICE_TOKEN=replace-with-independent-service-token
HERMES_BASE_URL=http://127.0.0.1:8003
HERMES_API_KEY=replace-with-server-side-hermes-key

# Frontend build variable; blank means same-origin API via reverse proxy.
VITE_CUSTOM_BACKEND_URL=
